# Copy to .env.local for local development. Never commit credentials.
# Mock performs validation and rate limiting, but NEVER sends email.
# Live sending requires explicit CONTACT_TRANSPORT=resend plus every live setting.
# Development, test and Vercel preview environments cannot use live transport.
# Production configuration and authorized redeployment: docs/M4-EMAIL-DEPLOYMENT-GUIDE.md
CONTACT_TRANSPORT=mock
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Apex and www HTTPS portfolio origins are built in. Add only exact trusted origins.
RESEND_API_KEY=
CONTACT_TO_EMAIL=mishrasaksham080705@gmail.com
# Use a verified sending subdomain of sakshamkumarmishra.cv (plain email address).
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 32 random characters; used to hash limiter identifiers.
CONTACT_RATE_LIMIT_SECRET=
